@model MyApp.Web.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">User Management</h3>
        <p class="text-muted mb-0">Search, manage roles, and control access for enterprise accounts</p>
    </div>
    <div>
        <a href="~/Users/Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-2"></i>Create User
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Search name, username, email..." value="@Model.Search.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="RoleId" class="form-select">
                    <option value="">All Security Roles</option>
                    @foreach (var r in Model.Roles)
                    {
                        <option value="@r.RoleId" selected="@(Model.Search.RoleId == r.RoleId ? "selected" : null)">@r.RoleName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="1" selected="@(Model.Search.Status == 1 ? "selected" : null)">Active</option>
                    <option value="0" selected="@(Model.Search.Status == 0 ? "selected" : null)">Inactive</option>
                    <option value="2" selected="@(Model.Search.Status == 2 ? "selected" : null)">Locked</option>
                </select>
            </div>
            <div class="col-md-3 d-flex">
                <button type="submit" class="btn btn-primary me-2"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a href="~/Users" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Username</th>
                        <th>FullName & Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x display-6 d-block mb-2"></i>
                                No users found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td class="small text-muted font-monospace">@(string.IsNullOrEmpty(u.EmployeeNumber) ? "—" : u.EmployeeNumber)</td>
                                <td class="fw-semibold">@u.Username</td>
                                <td>
                                    <div class="fw-semibold">@u.FullName</div>
                                    <div class="small text-muted">@u.Email</div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary">@u.RoleName</span>
                                </td>
                                <td>
                                    @if (u.Status == 1)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (u.Status == 2)
                                    {
                                        <span class="badge bg-warning text-dark">Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(u.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "Never")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="~/Users/Edit/@u.UserId" class="btn btn-outline-secondary" title="Edit User">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (u.Status == 1)
                                        {
                                            <form asp-action="ToggleStatus" asp-route-id="@u.UserId" asp-route-activate="false" method="post" class="d-inline" onsubmit="return confirm('Deactivate this user account?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="Deactivate Account">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleStatus" asp-route-id="@u.UserId" asp-route-activate="true" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Activate Account">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="Delete" asp-route-id="@u.UserId" method="post" class="d-inline" onsubmit="return confirm('Permanently delete user @u.Username?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete User">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white py-3">
        @if (Model.Pagination != null)
        {
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        }
    </div>
</div>
