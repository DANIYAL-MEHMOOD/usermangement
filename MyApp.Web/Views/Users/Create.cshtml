@model MyApp.Web.ViewModels.UserFormViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Create New User Account</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control" placeholder="jdoe" required />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmployeeNumber" class="form-label fw-semibold">Employee ID</label>
                            <input asp-for="EmployeeNumber" class="form-control" placeholder="EMP-001" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="john.doe@enterprise.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="Phone" class="form-control" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RoleId" class="form-label fw-semibold">Security Role <span class="text-danger">*</span></label>
                            <select asp-for="RoleId" class="form-select" required>
                                <option value="">-- Select Role --</option>
                                @foreach (var r in Model.AvailableRoles)
                                {
                                    <option value="@r.RoleId">@r.RoleName</option>
                                }
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label fw-semibold">Designation</label>
                            <input asp-for="Designation" class="form-control" placeholder="Senior Analyst" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="Engineering" />
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-key me-2 text-primary"></i>Initial Password Configuration</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" required minlength="8" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" required minlength="8" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="~/Users" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
