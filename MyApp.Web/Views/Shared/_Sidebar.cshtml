<aside class="app-sidebar bg-dark text-white d-flex flex-column p-3 flex-shrink-0" id="mainSidebar" style="min-height: 100vh;">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
        <i class="bi bi-shield-check text-primary fs-3 me-2"></i>
        <span class="fs-5 fw-bold text-white tracking-wide">MyApp Admin</span>
    </div>

    <div class="sidebar-menu overflow-auto flex-grow-1">
        @await Component.InvokeAsync("SidebarMenu")
    </div>

    <div class="sidebar-footer mt-auto pt-3 border-top border-secondary text-secondary small">
        <div class="d-flex justify-content-between align-items-center">
            <span>&copy; 2026 MyApp</span>
            <span class="badge bg-secondary">v8.0</span>
        </div>
    </div>
</aside>
