<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyApp Enterprise Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <div class="app-shell d-flex flex-grow-1">
        @await Html.PartialAsync("_Sidebar")

        <div class="main-wrapper d-flex flex-column flex-grow-1 overflow-hidden" style="min-width: 0;">
            @await Html.PartialAsync("_Navbar")

            <main class="content-area p-4 flex-grow-1">
                <div class="container-fluid p-0">
                    @await Html.PartialAsync("_Alerts")
                    @RenderBody()
                </div>
            </main>

            @await Html.PartialAsync("_Footer")
        </div>
    </div>

    <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
