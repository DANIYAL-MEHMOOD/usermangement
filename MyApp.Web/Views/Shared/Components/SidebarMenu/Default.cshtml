@model List<MyApp.Web.DTOs.MenuNodeDto>

<ul class="nav nav-pills flex-column mb-auto sidebar-nav">
    <li class="nav-item">
        <a href="~/Dashboard" class="nav-link text-white d-flex align-items-center py-2 px-3 mb-1 rounded-2">
            <i class="bi bi-speedometer2 me-3 fs-5"></i>
            <span>Dashboard</span>
        </a>
    </li>

    @foreach (var node in Model.OrderBy(m => m.DisplayOrder))
    {
        @if (node.IsActive)
        {
            @await Html.PartialAsync("Components/SidebarMenu/_MenuNode", node)
        }
    }
</ul>
