@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card shadow-sm border-0 rounded-3 p-4">
                <div class="card-body">
                    <div class="mb-4 text-danger">
                        <i class="bi bi-shield-lock-fill display-1"></i>
                    </div>
                    <h2 class="fw-bold mb-3">403 - Access Denied</h2>
                    <p class="text-muted mb-4">
                        You do not have sufficient permissions to access this module or perform this action.
                    </p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a href="~/Dashboard" class="btn btn-primary px-4">
                            <i class="bi bi-house-door me-2"></i>Return to Dashboard
                        </a>
                        <button onclick="window.history.back()" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-2"></i>Go Back
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
