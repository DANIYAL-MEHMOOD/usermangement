@model MyApp.Web.ViewModels.MenuFormViewModel
@{
    ViewData["Title"] = "Edit Menu";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Navigation Menu (@Model.Title)</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.MenuId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MenuId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="ParentMenuId" class="form-label fw-semibold">Parent Menu (Optional)</label>
                        <select asp-for="ParentMenuId" class="form-select">
                            <option value="">-- Root Level Menu --</option>
                            @foreach (var p in Model.ParentOptions)
                            {
                                @if (p.MenuId != Model.MenuId)
                                {
                                    <option value="@p.MenuId" selected="@(Model.ParentMenuId == p.MenuId ? "selected" : null)">@p.Title</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Menu Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Icon" class="form-label fw-semibold">Bootstrap Icon Class</label>
                        <input asp-for="Icon" class="form-control" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ControllerPage" class="form-label fw-semibold">Controller / Page</label>
                            <input asp-for="ControllerPage" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Route" class="form-label fw-semibold">Route (Optional)</label>
                            <input asp-for="Route" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4 align-items-center">
                        <div class="col-md-6">
                            <label asp-for="DisplayOrder" class="form-label fw-semibold">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="form-control" />
                        </div>
                        <div class="col-md-6 pt-md-4">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">Active Status</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="~/Menus" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
