@model MyApp.Web.ViewModels.DashboardViewModel
@inject MyApp.Web.Services.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Executive Dashboard</h3>
        <p class="text-muted mb-0">System metrics, security overview, and real-time audit activity</p>
    </div>
    <div>
        @if (CurrentUser.IsAdministrator)
        {
            <a href="~/Users/Create" class="btn btn-primary btn-sm me-2">
                <i class="bi bi-person-plus-fill me-1"></i>New User
            </a>
            <a href="~/Roles/Create" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-shield-plus me-1"></i>New Role
            </a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-0">@Model.Summary.TotalUsers</h2>
                    <span class="text-muted small">Total Registered Users</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-success-subtle text-success rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                    <i class="bi bi-person-check-fill fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-0">@Model.Summary.ActiveUsers</h2>
                    <span class="text-muted small">Active Accounts</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning-subtle text-warning rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                    <i class="bi bi-shield-lock-fill fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-0">@Model.Summary.LockedUsers</h2>
                    <span class="text-muted small">Locked Accounts</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-info-subtle text-info rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                    <i class="bi bi-diagram-3-fill fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-0">@Model.Summary.TotalRoles</h2>
                    <span class="text-muted small">Security Roles</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Security Logins</h6>
                <span class="badge bg-light text-dark">Latest 10</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Summary.RecentLogins.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No recent login activity recorded.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model.Summary.RecentLogins)
                                {
                                    <tr>
                                        <td class="fw-semibold">@(log.User ?? "System")</td>
                                        <td>
                                            <span class="badge @(log.Action.Contains("Success") ? "bg-success" : "bg-danger")">@log.Action</span>
                                        </td>
                                        <td class="small text-muted">@log.Details</td>
                                        <td class="small text-muted text-nowrap">@log.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-journal-check me-2 text-primary"></i>System Audit Feed</h6>
                <span class="badge bg-light text-dark">Real-Time</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Module</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Summary.AuditLogs.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No recent audit log entries.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var audit in Model.Summary.AuditLogs)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@audit.Module</span></td>
                                        <td class="fw-semibold small">@audit.Action</td>
                                        <td class="small text-muted">@audit.Details</td>
                                        <td class="small text-muted text-nowrap">@audit.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
