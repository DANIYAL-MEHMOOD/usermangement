@model MyApp.Web.ViewModels.RoleListViewModel
@{
    ViewData["Title"] = "Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Role & Privilege Management</h3>
        <p class="text-muted mb-0">Define security roles and control access privileges across enterprise modules</p>
    </div>
    <div>
        <a href="~/Roles/Create" class="btn btn-primary">
            <i class="bi bi-shield-plus me-2"></i>Create Role
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Role Name</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Assigned Users</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Roles.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">No roles found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model.Roles)
                        {
                            <tr>
                                <td class="font-monospace small text-muted">#@r.RoleId</td>
                                <td class="fw-bold">@r.RoleName</td>
                                <td class="text-muted small">@r.Description</td>
                                <td>
                                    @if (r.IsSystemRole)
                                    {
                                        <span class="badge bg-danger-subtle text-danger"><i class="bi bi-lock-fill me-1"></i>System</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Custom</span>
                                    }
                                </td>
                                <td>
                                    @if (r.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info">@r.UserCount Users</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="~/Permissions?roleId=@r.RoleId" class="btn btn-outline-primary" title="Configure Permissions">
                                            <i class="bi bi-key-fill"></i>
                                        </a>

                                        @if (!r.IsSystemRole)
                                        {
                                            <a href="~/Roles/Edit/@r.RoleId" class="btn btn-outline-secondary" title="Edit Role">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                        <a href="~/Roles/Clone/@r.RoleId" class="btn btn-outline-info" title="Clone Role">
                                            <i class="bi bi-copy"></i>
                                        </a>

                                        @if (!r.IsSystemRole)
                                        {
                                            <form asp-action="Delete" asp-route-id="@r.RoleId" method="post" class="d-inline" onsubmit="return confirm('Delete role @r.RoleName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete Role">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
