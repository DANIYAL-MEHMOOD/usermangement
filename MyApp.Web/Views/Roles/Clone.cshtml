@model MyApp.Web.ViewModels.RoleCloneViewModel
@{
    ViewData["Title"] = "Clone Role";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-copy me-2 text-primary"></i>Clone Role Matrix & Privileges</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Clone" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SourceRoleId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Source Role</label>
                        <select asp-for="SourceRoleId" class="form-select" disabled>
                            @foreach (var r in Model.ExistingRoles)
                            {
                                <option value="@r.RoleId">@r.RoleName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewRoleName" class="form-label fw-semibold">New Role Name <span class="text-danger">*</span></label>
                        <input asp-for="NewRoleName" class="form-control" placeholder="e.g. Cloned_Role" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="~/Roles" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Clone Role & Permissions</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
