@model MyApp.Web.ViewModels.RoleFormViewModel
@{
    ViewData["Title"] = "Edit Role";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Security Role (@Model.RoleName)</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.RoleId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RoleId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="RoleName" class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                        <input asp-for="RoleName" class="form-control" required />
                        <span asp-validation-for="RoleName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active Status</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="~/Roles" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
