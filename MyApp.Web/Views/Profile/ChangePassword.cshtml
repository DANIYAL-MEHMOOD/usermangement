@model MyApp.Web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-key-fill me-2 text-primary"></i>Change Account Password</h5>
            </div>
            <div class="card-body p-4">
                @if (Model.Success)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle-fill me-2"></i> @Model.Message
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.Message
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold">Current Password <span class="text-danger">*</span></label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                        <input asp-for="NewPassword" type="password" class="form-control" required minlength="8" />
                        <div class="form-text small">At least 8 characters with upper, lower, number, and symbol.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Confirm New Password <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" required minlength="8" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="~/Profile" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
