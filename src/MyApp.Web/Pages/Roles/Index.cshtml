@page
@model MyApp.Web.Pages.Roles.IndexModel
@{
    ViewData["Title"] = "Roles";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\">User Management</li><li class=\"breadcrumb-item active\">Roles</li>";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Roles</h4>
    <button class="btn btn-primary btn-sm" onclick="openCreateModal()">
        <i class="bi bi-plus-lg me-1"></i>New Role
    </button>
</div>

<div class="card mb-3">
    <div class="card-body row g-2">
        <div class="col-md-4">
            <input type="text" id="searchTerm" class="form-control form-control-sm" placeholder="Search roles..." />
        </div>
        <div class="col-md-3">
            <select id="filterActive" class="form-select form-select-sm">
                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Disabled</option>
            </select>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Role Name</th>
                    <th>Description</th>
                    <th>Users</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="roleTableBody">
                <tr><td colspan="5"><div class="skeleton" style="height:20px;"></div></td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Create / Edit modal -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="roleForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="roleModalTitle">New Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="roleId" />
                    <div class="mb-3">
                        <label class="form-label">Role Name *</label>
                        <input class="form-control" id="roleName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="description" rows="3"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="isActive" checked />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Clone modal -->
<div class="modal fade" id="cloneModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="cloneForm">
                <div class="modal-header">
                    <h5 class="modal-title">Clone Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="cloneSourceId" />
                    <p class="small text-muted">Copies every menu/permission grant from the source role onto a new role.</p>
                    <div class="mb-3">
                        <label class="form-label">New Role Name *</label>
                        <input class="form-control" id="cloneRoleName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="cloneDescription" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Clone</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let debounceTimer;

    function statusBadge(active) {
        return active ? '<span class="badge text-bg-success">Active</span>' : '<span class="badge text-bg-secondary">Disabled</span>';
    }

    async function loadRoles() {
        const tbody = document.getElementById('roleTableBody');
        tbody.innerHTML = `<tr><td colspan="5"><div class="skeleton" style="height:20px;"></div></td></tr>`;

        const params = new URLSearchParams({ handler: 'Search', searchTerm: document.getElementById('searchTerm').value });
        const activeFilter = document.getElementById('filterActive').value;
        if (activeFilter) params.set('isActive', activeFilter);

        const { body } = await callApi(`?${params.toString()}`, { method: 'GET' });
        if (!body || !body.success) { showToast(body?.message || 'Failed to load roles.', 'danger'); return; }

        const roles = body.data || [];
        tbody.innerHTML = roles.length ? roles.map(r => `
            <tr>
                <td>${escapeHtml(r.roleName)} ${r.isSystemRole ? '<span class="badge text-bg-info ms-1">System</span>' : ''}</td>
                <td class="text-muted small">${escapeHtml(r.description || '-')}</td>
                <td>${r.userCount}</td>
                <td>${statusBadge(r.isActive)}</td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <a class="btn btn-outline-primary" href="/Permissions?roleId=${r.roleId}" title="Permission Matrix"><i class="bi bi-grid-3x3"></i></a>
                        <button class="btn btn-outline-secondary" onclick='openEditModal(${JSON.stringify(r)})' ${r.isSystemRole ? 'disabled' : ''}><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-outline-secondary" onclick="openCloneModal(${r.roleId})"><i class="bi bi-files"></i></button>
                        <button class="btn btn-outline-danger" onclick="deleteRole(${r.roleId})" ${r.isSystemRole || r.userCount > 0 ? 'disabled' : ''}><i class="bi bi-trash"></i></button>
                    </div>
                </td>
            </tr>
        `).join('') : `<tr><td colspan="5" class="text-center text-muted py-4">No roles found.</td></tr>`;
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str ?? '';
        return div.innerHTML;
    }

    document.getElementById('searchTerm').addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(loadRoles, 350);
    });
    document.getElementById('filterActive').addEventListener('change', loadRoles);

    function openCreateModal() {
        document.getElementById('roleForm').reset();
        document.getElementById('roleId').value = '';
        document.getElementById('roleModalTitle').textContent = 'New Role';
        document.getElementById('isActive').checked = true;
        new bootstrap.Modal(document.getElementById('roleModal')).show();
    }

    function openEditModal(r) {
        document.getElementById('roleId').value = r.roleId;
        document.getElementById('roleName').value = r.roleName;
        document.getElementById('description').value = r.description || '';
        document.getElementById('isActive').checked = r.isActive;
        document.getElementById('roleModalTitle').textContent = 'Edit Role';
        new bootstrap.Modal(document.getElementById('roleModal')).show();
    }

    function openCloneModal(sourceId) {
        document.getElementById('cloneForm').reset();
        document.getElementById('cloneSourceId').value = sourceId;
        new bootstrap.Modal(document.getElementById('cloneModal')).show();
    }

    document.getElementById('roleForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const idValue = document.getElementById('roleId').value;
        const payload = {
            roleId: idValue ? parseInt(idValue, 10) : null,
            roleName: document.getElementById('roleName').value,
            description: document.getElementById('description').value || null,
            isActive: document.getElementById('isActive').checked
        };
        const { body } = await callApi('?handler=Save', { method: 'POST', body: JSON.stringify(payload) });
        if (body && body.success) {
            showToast(body.message || 'Role saved.', 'success');
            bootstrap.Modal.getInstance(document.getElementById('roleModal'))?.hide();
            loadRoles();
        } else showToast(body?.message || 'Save failed.', 'danger');
    });

    document.getElementById('cloneForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            sourceRoleId: parseInt(document.getElementById('cloneSourceId').value, 10),
            newRoleName: document.getElementById('cloneRoleName').value,
            description: document.getElementById('cloneDescription').value || null
        };
        const { body } = await callApi('?handler=Clone', { method: 'POST', body: JSON.stringify(payload) });
        if (body && body.success) {
            showToast(body.message || 'Role cloned.', 'success');
            bootstrap.Modal.getInstance(document.getElementById('cloneModal'))?.hide();
            loadRoles();
        } else showToast(body?.message || 'Clone failed.', 'danger');
    });

    async function deleteRole(id) {
        const confirmed = await confirmDialog('Delete this role? This cannot be undone.', 'Delete role');
        if (!confirmed) return;
        const { body } = await callApi(`?handler=Delete&id=${id}`, { method: 'POST' });
        if (body && body.success) { showToast(body.message, 'success'); loadRoles(); }
        else showToast(body?.message || 'Delete failed.', 'danger');
    }

    loadRoles();
</script>
}
