@using MyApp.Web.Services
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Xsrf.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - MyApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        // Applied before first paint to avoid a flash of the wrong theme.
        (function () {
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', t === 'auto'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : t);
        })();
    </script>
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            @await Component.InvokeAsync("SidebarMenu")
        </aside>

        <div class="app-main">
            <header class="app-topbar d-flex align-items-center justify-content-between px-3">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" id="sidebarToggle" title="Collapse sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    @if (ViewData["Breadcrumb"] is string breadcrumb)
                    {
                        <nav aria-label="breadcrumb" class="ms-2">
                            <ol class="breadcrumb mb-0 small">
                                @Html.Raw(breadcrumb)
                            </ol>
                        </nav>
                    }
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary position-relative" data-bs-toggle="dropdown">
                            <i class="bi bi-bell"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-2" style="width: 280px;">
                            <p class="small text-muted mb-0">No new notifications.</p>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString(SessionKeys.FullName)
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                            <li><a class="dropdown-item" href="/Settings/Theme"><i class="bi bi-palette me-2"></i>Theme</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" action="/Logout">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content p-4">
                @RenderBody()
            </main>

            <footer class="app-footer text-center small text-muted py-2">
                &copy; @DateTime.Now.Year MyApp — All rights reserved.
            </footer>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
