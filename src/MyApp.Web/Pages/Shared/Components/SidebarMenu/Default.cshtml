@model List<MyApp.Web.ViewComponents.MenuNode>

<div class="px-3 pt-3 pb-2 d-flex align-items-center gap-2">
    <i class="bi bi-shield-check fs-4 text-white"></i>
    <span class="fw-semibold text-white fs-5">MyApp</span>
</div>
<div class="px-3 pb-2">
    <input type="text" id="menuSearch" class="form-control form-control-sm" placeholder="Search menu..." />
</div>
<nav class="nav flex-column px-2" id="sidebarNav">
    @foreach (var node in Model.OrderBy(m => m.MenuOrder))
    {
        @await Html.PartialAsync("Components/SidebarMenu/_MenuNode", node)
    }
</nav>

<script>
    document.getElementById('menuSearch')?.addEventListener('input', function (e) {
        const term = e.target.value.trim().toLowerCase();
        document.querySelectorAll('#sidebarNav .menu-item').forEach(el => {
            const matches = el.dataset.name.includes(term);
            el.style.display = term === '' || matches ? '' : 'none';
        });
    });
</script>
