@page
@model MyApp.Web.Pages.ChangePasswordModel
@{ ViewData["Title"] = "Change Password"; ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item active\">Change Password</li>"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Change Password</h5>

                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert @(Model.Success ? "alert-success" : "alert-danger") py-2">@Model.StatusMessage</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Current Password</label>
                        <input asp-for="Input.CurrentPassword" type="password" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input asp-for="Input.NewPassword" type="password" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm New Password</label>
                        <input asp-for="Input.ConfirmNewPassword" type="password" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Update Password</button>
                </form>
            </div>
        </div>
    </div>
</div>
