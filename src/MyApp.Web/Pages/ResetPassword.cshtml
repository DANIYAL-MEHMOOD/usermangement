@page
@model MyApp.Web.Pages.ResetPasswordModel
@{ ViewData["Title"] = "Reset Password"; Layout = null; }
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <title>Reset Password - MyApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-sm" style="width: 380px;">
        <div class="card-body p-4">
            <h5 class="card-title mb-3 text-center">Reset Password</h5>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert @(Model.Success ? "alert-success" : "alert-danger") py-2">@Model.StatusMessage</div>
            }

            @if (!Model.Success)
            {
                <form method="post">
                    <input type="hidden" asp-for="Input.Token" />
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input asp-for="Input.NewPassword" type="password" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm New Password</label>
                        <input asp-for="Input.ConfirmNewPassword" type="password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Reset Password</button>
                </form>
            }
            else
            {
                <a asp-page="/Login" class="btn btn-outline-secondary w-100">Back to sign in</a>
            }
        </div>
    </div>
</body>
</html>
